{
  "name": "figma-make-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "format": "oxfmt",
    "server:build": "tsc -p server/tsconfig.json",
    "server:dev": "node --env-file=.env dist-server/main.js",
    "db:generate": "prisma generate",
    "db:deploy": "prisma migrate deploy",
    "db:migrate": "prisma migrate dev",
    "db:seed": "node --env-file=.env dist-server/seed.js",
    "test:server": "node --env-file=.env --test --test-concurrency=1 dist-server/auth.test.js dist-server/learning.test.js dist-server/quiz.test.js",
    "test:excel": "node scripts/test-vocabulary-excel.cjs",
    "test:csv": "node scripts/test-vocabulary-csv.cjs",
    "test:i18n": "node scripts/check-i18n.cjs"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.3",
    "@nestjs/core": "^11.2.3",
    "@nestjs/platform-express": "^11.2.3",
    "@prisma/client": "6.19.0",
    "cookie-parser": "^1.4.7",
    "exceljs": "^4.4.0",
    "fflate": "^0.8.3",
    "helmet": "^8.3.0",
    "lucide-react": "1.42.0",
    "nodemailer": "^10.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.0.0",
    "oxfmt": "^0.2.0",
    "prisma": "6.19.0",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.5"
  }
}
