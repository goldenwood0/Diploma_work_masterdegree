# Local development only. Copy to .env and replace both matching passwords.
POSTGRES_PASSWORD=replace-with-a-random-local-password
DATABASE_URL=postgresql://zhpath:replace-with-a-random-local-password@127.0.0.1:5433/zhpath
APP_ORIGIN=http://127.0.0.1:8443
API_PORT=3001
NODE_ENV=development
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
MAIL_FROM=ZhPath <noreply@zhpath.local>
# Enable the reminder worker only after SMTP is configured.
REMINDERS_ENABLED=false
# Production SMTP credentials go only in .env / secret storage, never in VITE_*.
# SMTP_USER=
# SMTP_PASSWORD=
